name asm

*FILETYPE compound
comment disable dump, cache enable, xclear enable, fnlock disable, recursive enable
*CONFIG d0 c1 x1 f0 r1 e9600

comment minimum version required
*uVERSION 8a30c3


displayrule errors disable
displayrule unknowns disable
displayrule prints disable

print text "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"

comment Add necessary functions

py:self.python_context["x"]=0

comment Set variables
general set variable rtid to py:rtid
general set variable _framework to nul
general set variable __spec__ to None
general set variable NotImplemented to None
general set variable linecount to 0

