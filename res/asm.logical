function queue(qname op data loc) {
    if param:op equal "n" { Array.array(param:qname) }
    if param:op equal "a" { Array.arrayAppend(param:qname param:data) }
    if param:op equal "t" { return Array.arrayRead(param:qname 0) }
    if param:op equal "r" { return Array.arrayRemove(param:qname param:loc) }
}

function stack(id op data) {
    general set variable name to STACK!param:id!
    if param:op equal 2 { Array.array(!name!) }
    if param:op equal 0 { Array.arrayAppend(!name! param:data) }
    if param:op equal 1 { return Array.arrayRead(!name! 0) then arrayRShift(!name!) }
}

