fclass wterm {
    function cmd0(x) {
        py:os.system("param:x")
    }
    function cmd1(x y) {
        Error.SystemError(InternalError)
        py:os.system("param:x\x20param:y")
    }
    function cmd2(x y z) {
        Error.SystemError(InternalError)
        py:os.system("param:x\x20param:y\x20param:z")
    }
    function cmd3(x y z a) {
        Error.SystemError(InternalError)
        py:os.system("param:x\x20param:y\x20param:z\x20param:a")
    }
}

