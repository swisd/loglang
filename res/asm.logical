fclass flags {
    function init() {
        general set variable _flags to TypeVar(_flags)
        Flags.flag(u3 false)
    }
    function flag(name data id) {
        comment set a flag
        general set variable flaglist[param:id] to param:name
        general set variable flags[param:id] to param:data
        return 0
    }
    function getflag(id) {
        algebraic set variable fmtout to "!flaglist[param:id]!" + "[" + "!flags[param:id]!" + "]"
        return fmtout
    }
    function isolated() {
