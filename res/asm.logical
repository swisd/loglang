fclass codec {
    function textcodec(data) {
        ref mix *c compare hexbytes textbytes for 1 in hexbytes to 1 in textbytes until end both delta len 0 *r var out
        if param:data equal type.hex { for ref in out if param:data equal ref[0] return ref[1] }
        if param:data equal type.text { for ref in out if param:data equal ref[1] return ref[0] }
        if param:data not equal type.hex and param:data not equal type.text { raise Error.error("Incorrect type for function") }
    }

    function compilecodec(data) {
        ref mix *c compare logwords loghexcompbytes for 1 in logwords to 1 in loghexcompbytes until end both delta len 0 *r var out
        if param:data equal type.hex { for ref in out if param:data equal ref[1] return ref[0] }
        if param:data equal type.text { for ref in out if param:data equal ref[0] return ref[1] }
        if param:data not equal type.hex and param:data not equal type.text { raise Error.error("Incorrect type for function") }
    }
}

