input txt "Input any ascii character $ "
general set variable numbered to ord(!txt!)
general set variable letter to chr(!numbered!)
comment Hex gives us decimal value for some reason
general set variable hexnum to hex(!numbered!)
print text "DEC: !numbered!"
print text "ASCII: !letter!"
print text "HEX: !hexnum!"


input val1 "Input value one (int): "
input val2 "Input value two (int): "


if !val1! > !val2! then { print text "value one is greater than value two" }
if !val1! == !val2! then { print text "value one is equal than value two" }
if !val1! < !val2! then { print text "value one is less than value two" }


