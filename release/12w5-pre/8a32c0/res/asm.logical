comment Array operations builtin

fclass Array {
    function array(arr) {
        general set variable param:arr[0] to nul
    }

    function arrayWrite(arr index data) {
        general set variable param:arr[param:index] to param:data
    }

    function arrayRead(arr index) {
        return PyOp.PyGetArr(param:arr param:index)
    }

    function compArrayRead(arr index) {
        return returns.computed(param:arr[param:index])
    }

    function arrayRemove(arr index) {
        general set variable param:arr[param:index] to .
    }
}
comment Old array functions (Deprecated)
function _array(array) {
    general set variable ARRAY_!param:array!_[0] to nul
    Warning.DeprecationWarning(DeprecatedFunction)
}
function _arrayWrite(array index data) {
    Warning.DeprecationWarning(DeprecatedFunction)
    general set variable ARRAY_!param:array!_[!param:index!] to param:data
}

function _arrayRead(array index) {
    Warning.DeprecationWarning(DeprecatedFunction)
    algebraic set variable index to "ARRAY_" + "param:array" + "_[" + "param:index" + "]"
    return !index!
}

function _compArrayRead(array index) {
    Warning.DeprecationWarning(DeprecatedFunction)
    algebraic set variable index to "ARRAY_" + "param:array" + "_" + "param:index"
    return returns.computed(!index!)
}

function _arrayRemove(array index) {
    Warning.DeprecationWarning(DeprecatedFunction)
    general set variable ARRAY_!param:array!_[!param:index!] to .
}

function _arrayAppend(array data) {
    Warning.DeprecationWarning(DeprecatedFunction)
    operation set variable arrayLen to len of param:array
    algebraic set variable position to !arrayLen! + 1
    general set variable arrayVar to param:array:!position!
}

function _arrayRShift(array){
    Warning.DeprecationWarning(DeprecatedFunction)
    general set variable data to _arrayRead(param:array 0)
    _arrayRemove(param:array)
    for i from 1 to len of array {
        general set variable dt to _arrayRead(param:array !i!)
        algebraic set variable addI to !i! - 1
        _arrayWrite(param:array !addI! !dt!)
        _arrayRemove(param:array !i!)
    }
}

